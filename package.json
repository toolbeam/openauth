{
  "name": "openauthjs",
  "module": "index.ts",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/client/*"
  ],
  "scripts": {
    "build:core": "bun run --filter @openauthjs/core build",
    "build:vite": "bun run --filter @openauthjs/vite build",
    "build:react": "bun run --filter @openauthjs/react build",
    "build:unfonts": "bun run --filter @openauthjs/unfonts build",
    "build:openauth": "bun run --filter @openauthjs/openauth build",
    "release": "bun run build:core && bun run build:vite && bun run build:react && bun run build:unfonts && bun run build:openauth && changeset publish"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.0",
    "@types/bun": "latest"
  },
  "dependencies": {
    "@changesets/cli": "2.27.10",
    "prettier": "3.4.2",
    "typescript": "5.6.3"
  },
  "private": true
}
